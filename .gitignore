# All intermediate objects, sanitizer binaries, and fuzz artifacts live here.
/obj/

# Compiler/linker output (also covers manual builds outside obj/).
*.o
*.obj
*.d
*.gch
*.pch
*.i
*.a
*.lib
*.la
*.lo
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.map
*.ilk
*.exp

# Export lists in symbols/ are source inputs, not generated linker output.
!/symbols/*.exp

# Executables generated in the project root; keep tests/*.c visible to Git.
/example
/example-aes
/test_nist_md5
/test_nist_sha256
/test_nist_sha3
/test_nist_aes256
/test_nist_arcfour
/test_regressions
/test_examples
/test_file_failures

# Debug/profiling output.
*.dSYM/
*.su
*.idb
*.pdb
*.dwo
*.gcda
*.gcno
*.profraw
*.profdata

# Older vector tests can leave these exact fixtures behind after a failed run.
/tmp_nist_md5.bin
/tmp_nist_sha256.bin
/tmp_nist_sha3.bin
/test_input.txt
/test_encrypted.bin
/test_decrypted.txt

# Local OS/editor metadata. Already-tracked files are unaffected by ignore rules.
.DS_Store
/.vscode/
